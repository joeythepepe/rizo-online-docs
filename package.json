{
  "name": "poster-business",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check:print-classes": "bash scripts/check-print-classes.sh",
    "fonts:subset": "bash scripts/fonts-subset.sh",
    "validate:content": "bun scripts/validate-content.mjs",
    "export:pdf": "bun scripts/export-pdf.ts",
    "export:all": "bun scripts/export-all.ts",
    "test:smoke": "bun run build && playwright test"
  },
  "dependencies": {
    "country-flag-icons": "^1.6.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.61.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  },
  "packageManager": "bun@1.3.14"
}
